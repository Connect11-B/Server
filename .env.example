DB_NAME=village
DB_USERNAME=village
DB_PASSWORD=
REDIS_PASSWORD=
JWT_SECRET=
AUTH_CODE_PEPPER=
CORS_ALLOWED_ORIGINS=http://localhost:5173
# 운영 메일 발신 주소 (prod, SMTP 사용 시)
MAIL_FROM=
# 최초 관리자 시드. 서버 시작 시 계정이 없을 때만 한 번 생성합니다.
# 생성 후에는 ADMIN_PASSWORD를 .env에서 지우세요. (비어 있으면 시드를 건너뜁니다)
ADMIN_EMAIL=
ADMIN_PASSWORD=
ADMIN_NAME=관리자
# refresh token 쿠키. 프론트와 API가 서로 다른 사이트면 None(Secure 필수), 같은 사이트면 Strict
COOKIE_SAME_SITE=Strict
